# Copy to .env.local for local dev, and set the same values in Vercel's
# Project Settings -> Environment Variables for deploys.
#
# NOTE: every VITE_ value is compiled into the browser bundle and is readable by
# anyone who opens devtools. Never put a real secret here — no API keys, no
# Backblaze application keys, no Firebase admin credentials. Vars WITHOUT the
# VITE_ prefix stay server-only and are safe for real secrets.

# ---- Firebase (Console -> Project settings -> your web app's config) ----
# These are safe to expose — Firebase's web config is meant to be public;
# access is actually controlled by firestore.rules, not by hiding this.
# Sign-in requires Google and/or Email/Password enabled under
# Authentication -> Sign-in method in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Firebase Admin (server-only, used by api/sign-upload.ts to verify who's
# uploading) — Console -> Project settings -> Service accounts -> Generate new
# private key. Paste the ENTIRE downloaded JSON file as one line here. ----
FIREBASE_SERVICE_ACCOUNT=

# ---- Backblaze B2 (server-only — never touches the browser) ----
# From your bucket's details page in the B2 console:
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Full URL including https://, e.g. https://s3.us-west-004.backblazeb2.com
B2_ENDPOINT=
# The region code out of that endpoint, e.g. us-west-004
B2_REGION=
# The bucket's "friendly URL" host, e.g. f004.backblazeb2.com — used to build
# public download links for shared recordings.
B2_DOWNLOAD_HOST=
